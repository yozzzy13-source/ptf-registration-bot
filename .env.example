# PTF — переменные окружения. Задаются в Railway → Variables (файл .env
# сервер не читает). Здесь — полный список того, что понимает код.

# --- Обязательные -----------------------------------------------------------
BOT_TOKEN=
# Адрес сервиса в Railway, без «/» в конце: на него ставится вебхук и открываются мини-приложения.
PUBLIC_URL=https://your-service.up.railway.app
# JSON ключа сервисного аккаунта Google одной строкой.
GOOGLE_CREDENTIALS=
# Telegram id организаторов через запятую; первый — главный (от него назначаются матчи плей-офф).
ADMIN_IDS=
# Основная таблица PTF: Applicants, Settings, Events, оплаты.
SPREADSHEET_ID=1KAVMKdT3Jn7kzZTCFaqTm2EGFxfG_5ou6n0PezeJSig
# Таблица матчей: Match Slots, Match Log, Courts.
MATCHES_SPREADSHEET_ID=
# Центральная таблица Match_Log: Cross_Division_Match_Log, Players_Master, Playoff
# (старое имя переменной — RESULTS_SHEET_ID, тоже работает).
LEAGUE_RESULTS_SHEET_ID=
NODE_ENV=production

